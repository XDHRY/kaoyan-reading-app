# ══════════════════════════════════════════════════════════════════
# 纸上功夫(考研传统阅读助手)·环境变量模板
# 用法:cp .env.example .env 后编辑;Docker Compose 会自动读取同目录 .env。
# 云服务器一键部署请直接用 deploy/cloud-init.sh(交互式生成 .env,免手填)。
# ══════════════════════════════════════════════════════════════════

# ── 应用基础 ──────────────────────────────────────────────────────
APP_ID=                   # 应用标识(本项目未强制使用,可留空)
APP_SECRET=               # 应用密钥,用于 JWT 签名——生产务必换成足够长的随机串!

# ── 管理员(生产必填)───────────────────────────────────────────────
# 管理员 admin 的初始密码。未设置时,首次启动会生成随机密码并仅在日志打印一次。
# 生产部署请务必设置并妥善保管;登录后可在个人中心修改。
ADMIN_PASSWORD=

# ── 数据库(Docker Compose 部署)───────────────────────────────────
# 前三行仅 compose 的 mysql 服务使用;DATABASE_URL 是应用连库串。
# ⚠ 修改 MYSQL_PASSWORD 时,必须同步修改 DATABASE_URL 里的口令!
DATABASE_URL=mysql://kaoyan:kaoyan_pass_change_me@mysql:3306/kaoyan_reading
MYSQL_ROOT_PASSWORD=root_pass_change_me   # MySQL root 口令(生产请修改)
MYSQL_DATABASE=kaoyan_reading             # 库名(与 DATABASE_URL 末尾一致)
MYSQL_USER=kaoyan
MYSQL_PASSWORD=kaoyan_pass_change_me      # 业务账号口令(生产请修改)

# ── 端口映射(Docker Compose 宿主机侧)─────────────────────────────
# APP_PORT:应用对外端口。国内云服务器「IP + 非 80/443 端口」直连可免备案;
#           如需 http://<IP>:80 访问则须域名备案,建议用 8080 等非标端口。
APP_PORT=3000
# DB_PORT:MySQL 对外端口。服务器本机若已有 MySQL 占 3306,请改 3307。
DB_PORT=3306
# PORT:容器内应用监听端口(一般不动,与 compose 内映射右值一致)。
PORT=3000

# ── CORS 白名单(额外放行,一般不用配)──────────────────────────────
# 逗号分隔的完整 origin。默认白名单已含:同源 Web/EXE、APK 壳
# (capacitor://localhost)、localhost/127.0.0.1 与局域网私有段(192.168./10.)。
# ▶ APK 场景:APK 的 WebView origin 是 capacitor://localhost,已在默认白名单,
#   公网 IP 直连时【无需】配置本项。
# 仅当有独立域名/独立端口的前端站点跨域访问时才填,如:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=
